# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://tuliwamu:tuliwamu_dev@localhost:5432/tuliwamu

# --- Field-level encryption (Fernet key) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- JWT / cookies ---
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
# Use "None" (with HTTPS) when frontend and backend are on different sites, otherwise "Lax"/"Strict"
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=False

# --- Cache (optional, recommended in production for rate limits) ---
# REDIS_URL=redis://localhost:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@tuliwamu.example
FRONTEND_URL=http://localhost:5173

# --- Africa's Talking ---
# Leave AFRICASTALKING_API_KEY empty to use the mock SMS provider (messages are marked SIMULATED).
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USSD_SERVICE_CODE=*384*1234#
AFRICASTALKING_USSD_CALLBACK_URL=https://your-backend.example/api/communications/ussd/callback/
AFRICASTALKING_USSD_EVENT_URL=https://your-backend.example/api/communications/ussd/events/
AFRICASTALKING_SMS_SENDER_ID=
# Optional shared token appended to callback URLs as ?token=... to reject forged callbacks
AFRICASTALKING_CALLBACK_TOKEN=

# --- Safeguarding contacts shown in USSD / beneficiary portal (verify before go-live) ---
EMERGENCY_CONTACT_TEXT=Child Helpline 116 (toll-free). Police 999 or 112.
